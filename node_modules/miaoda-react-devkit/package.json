{
  "name": "miaoda-react-devkit",
  "version": "0.1.1-beta.18",
  "description": "React admin 应用开发工具集",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js",
      "require": "./dist/vite/index.cjs"
    },
    "./cloud/vite.config": "./cloud/vite.config.js",
    "./tsconfig-base": "./tsconfig-base.json"
  },
  "files": [
    "dist",
    "cloud",
    "!cloud/**/*.ts",
    "tsconfig-base.json",
    "!dist/**/*.map"
  ],
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.0"
  },
  "peerDependencies": {
    "@sentry/core": ">=8.0.0",
    "@sentry/react": ">=8.0.0",
    "miaoda-sc-plugin": ">=1.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@sentry/core": {
      "optional": true
    },
    "@sentry/react": {
      "optional": true
    },
    "miaoda-sc-plugin": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
