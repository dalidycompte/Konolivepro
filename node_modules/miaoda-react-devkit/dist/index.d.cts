}

/** 捕获事件订阅者接口与消息类型定义。 */

/**
 * 捕获事件订阅者。
 * SentryCapture 捕获到事件后，逐个通知所有已注册的订阅者。
 * postMessage、日志输出、测试断言等均是不同的实现。
 */
interface ICaptureSubscriber {
    onConsole(info: IConsoleCaptureInfo): void;
    onError(info: IErrorCaptureInfo): void;
    /**
     * 仅在以下情况触发：
     * - isError 为 true（网络层失败）
     * - HTTP 4xx 客户端错误
     *
     * 2xx / 3xx / 5xx 不触发。
     */
    onNetworkRequest(info: INetworkRequestInfo): void;
    /**
     * 请求命中 PostgREST 端点，且响应体 code 字段在白名单中时触发。
     * 适用于需要对特定数据库业务错误（如唯一键冲突、JWT 过期）做专项处理的场景。
     */
    onPgRestWhitelistError(info: IPgRestWhitelistErrorInfo): void;
    /**
     * 请求命中 Auth 端点，且响应体 code 字段在白名单中时触发。
     * 适用于需要对特定认证错误（如邮箱未确认、格式无效）做专项处理的场景。
     */
    onAuthWhitelistError(info: IAuthWhitelistErrorInfo): void;
    /**
     * 请求命中 Storage 端点，且响应体 error 字段在白名单中时触发。
     * 适用于需要对特定存储错误（如行级安全策略拒绝）做专项处理的场景。
     */
