type PostMessageFn = (message: GlobalErrorMessage, targetOrigin: string) => void;

/**
 * Sentry 事件捕获封装。
 *
 * 提供三类观测能力：
 * - 错误捕获：通过 beforeSend 钩子提取异常信息
