        name: string;
        message: string;
        stack: string | null | undefined;
        fileName: string;
        lineNumber: number;
        columnNumber: number;
        httpPath?: string;
        httpStatus?: number;
        httpMethod?: string;
        requestBody?: string;
        responseBody?: string;
        /** PgRestWhitelistError 专属字段 */
        pgRestCode?: string;
        pgRestDetails?: string;
        pgRestHint?: string;
        requestType?: 'fetch' | 'xhr';
        /** AuthWhitelistError 专属字段 */
        authCode?: string;
        authRequestId?: string;
        /** StorageWhitelistError 专属字段 */
