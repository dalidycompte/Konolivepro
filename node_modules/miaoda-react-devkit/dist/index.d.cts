 *
 * 典型用法：实例化后将 beforeSend / beforeBreadcrumb 传入 Sentry.init()，
 * 并在 init 完成后调用 installNetworkObserver()，任意时机调用 installConsoleObserver()。
 */

declare class SentryCapture {
    private readonly subscribers;
    private readonly console;
    private readonly network;
    constructor(opts: ISentryCaptureOptions, subscribers?: readonly ICaptureSubscriber[]);
    /** 在 Sentry.init() 完成后调用一次，注册网络请求观测器。 */
    installNetworkObserver(): void;
    /** 注册控制台日志观测器，可在 Sentry.init() 前后调用均可。 */
    installConsoleObserver(): void;
    /** 传入 Sentry.init({ beforeSend }) —— 提取错误信息触发 onError 回调。 */
    beforeSend(event: ErrorEvent, hint: EventHint): ErrorEvent;
    /**
     * 传入 Sentry.init({ beforeBreadcrumb })。
     * - console：过滤噪音关键词
     * - fetch/xhr：过滤 ignoreUrls 匹配的静态资源请求
     */
    beforeBreadcrumb(breadcrumb: Breadcrumb, hint?: BreadcrumbHint): Breadcrumb | null;
}

